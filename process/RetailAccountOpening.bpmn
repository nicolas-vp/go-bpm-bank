<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:gobpm="https://github.com/nicolas-vp/go-bpm/schema/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RetailAccountOpening" targetNamespace="https://github.com/nicolas-vp/go-bpm-bank">
  <bpmn:process id="RetailAccountOpening" name="GoBpmBank · Открытие счёта" isExecutable="true">
    <bpmn:startEvent id="Start" name="Заявление" />
    <bpmn:callActivity id="Intake" name="01 · Приём заявления">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="CollectApplication" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Eligible" name="Успешно ли прошел приём ?" default="Flow_4" />
    <bpmn:callActivity id="Diligence" name="02 · Проверки и рассмотрение">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="DueDiligence" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Approved" name="Можно продолжить?" default="Flow_7" />
    <bpmn:callActivity id="Contract" name="03 · Договор">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="ConcludeContract" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Signed" name="Подписан?" default="Flow_10" />
    <bpmn:callActivity id="Open" name="04 · Открытие в АБС">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="OpenCoreAccount" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Opened" name="Зарегистрирован?" default="Flow_13" />
    <bpmn:callActivity id="Post" name="05 · Постобработка">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="PostOpening" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:endEvent id="Success" name="Счёт открыт" />
    <bpmn:endEvent id="Stopped" name="Заявление завершено" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="Intake" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Intake" targetRef="Eligible" />
    <bpmn:sequenceFlow id="Flow_3" name="Да" sourceRef="Eligible" targetRef="Diligence">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="Другой исход" sourceRef="Eligible" targetRef="Stopped" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="Diligence" targetRef="Approved" />
    <bpmn:sequenceFlow id="Flow_6" name="Да" sourceRef="Approved" targetRef="Contract">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" name="Другой исход" sourceRef="Approved" targetRef="Stopped" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="Contract" targetRef="Signed" />
    <bpmn:sequenceFlow id="Flow_9" name="Да" sourceRef="Signed" targetRef="Open">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">contractAccepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Клиент отказался" sourceRef="Signed" targetRef="Stopped" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Open" targetRef="Opened" />
    <bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Opened" targetRef="Post">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">accountOpened</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Требует разбирательства" sourceRef="Opened" targetRef="Stopped" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Post" targetRef="Success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_RetailAccountOpening">
    <bpmndi:BPMNPlane id="Plane_RetailAccountOpening" bpmnElement="RetailAccountOpening">
      <bpmndi:BPMNShape id="Diligence_di" bpmnElement="Diligence" isExpanded="false">
        <dc:Bounds x="420" y="150" width="160" height="85" />
