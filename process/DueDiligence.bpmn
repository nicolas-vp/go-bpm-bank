<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:gobpm="https://github.com/nicolas-vp/go-bpm/schema/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_DueDiligence" targetNamespace="https://github.com/nicolas-vp/go-bpm-bank">
  <bpmn:process id="DueDiligence" name="02 · Проверки и рассмотрение" isExecutable="true">
    <bpmn:startEvent id="Start" name="" />
    <bpmn:callActivity id="Checks" name="Проверить сведения">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="AutomatedChecks" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="RouteApplication" name="Определить порядок рассмотрения заявления">
      <bpmn:extensionElements>
        <gobpm:calledDecision decisionId="OnboardingRoute" resultVariable="route" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Route" name="Как продолжить?" default="Flow_6" />
    <bpmn:callActivity id="Clarify" name="Уточнить анкету">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="CollectApplication" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:callActivity id="Review" name="Ручное рассмотрение">
      <bpmn:extensionElements>
        <gobpm:calledElement processId="ComplianceReview" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="ReviewResult" name="Решение сотрудника" default="Flow_10" />
    <bpmn:task id="Accept" name="Продолжить оформление" />
    <bpmn:endEvent id="End" name="Рассмотрено" />
    <bpmn:task id="Decline" name="Зафиксировать правовое основание" />
    <bpmn:exclusiveGateway id="Clarified" name="Уточнение получено?" default="Flow_13" />
    <bpmn:endEvent id="Incomplete" name="Другой исход" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start" targetRef="Checks" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Checks" targetRef="RouteApplication" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="RouteApplication" targetRef="Route" />
    <bpmn:sequenceFlow id="Flow_4" name="Продолжить" sourceRef="Route" targetRef="Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">route == "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" name="Уточнить" sourceRef="Route" targetRef="Clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">route == "REQUEST_INFO"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Рассмотреть" sourceRef="Route" targetRef="Review" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Review" targetRef="ReviewResult" />
    <bpmn:sequenceFlow id="Flow_8" name="Продолжить" sourceRef="ReviewResult" targetRef="Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewDecision == "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="Уточнить" sourceRef="ReviewResult" targetRef="Clarify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reviewDecision == "REQUEST_INFO"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Мотивированный исход" sourceRef="ReviewResult" targetRef="Decline" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Clarify" targetRef="Clarified" />
    <bpmn:sequenceFlow id="Flow_12" name="Повторить проверки" sourceRef="Clarified" targetRef="Checks">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" name="Не продолжать" sourceRef="Clarified" targetRef="Incomplete" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Accept" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Decline" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DueDiligence">
    <bpmndi:BPMNPlane id="Plane_DueDiligence" bpmnElement="DueDiligence">
      <bpmndi:BPMNShape id="Route_di" bpmnElement="Route" isMarkerVisible="true">
        <dc:Bounds x="570" y="168" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="476" y="168" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Checks_di" bpmnElement="Checks" isExpanded="false">
        <dc:Bounds x="80" y="150" width="160" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RouteApplication_di" bpmnElement="RouteApplication">
