        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decline_di" bpmnElement="Decline">
        <dc:Bounds x="1120" y="267" width="160" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clarify_di" bpmnElement="Clarify" isExpanded="false">
        <dc:Bounds x="1120" y="397" width="160" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Clarified_di" bpmnElement="Clarified" isMarkerVisible="true">
        <dc:Bounds x="1345" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1342.5" y="378" width="55" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Incomplete_di" bpmnElement="Incomplete">
        <dc:Bounds x="1482" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1466" y="463" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
